+/*---------------------------------------------------------*\
+| Read-retry shim: some sticks answer intermittently on     |
+| SMBus, so retry identification reads before giving up.    |
+\*---------------------------------------------------------*/
+static int ReadByteRetry(i2c_smbus_interface* bus, unsigned char address, unsigned char reg, bool (*ok)(int))
+{
+    int res = -1;
+    for(int attempt = 0; attempt < 10; attempt++)
+    {
+        res = bus->i2c_smbus_read_byte_data(address, reg);
+        if(ok(res))
+        {
+            break;
+        }
+        std::this_thread::sleep_for(20ms);
+    }
+    return res;
+}
+
+static bool IsId43(int res) { return res == 0x1C; }
+static bool IsId44(int res) { return (res == 0x03) || (res == 0x04); }
